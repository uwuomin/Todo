<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid Height="600" RenderTransformOrigin="0.513,0.608" HorizontalAlignment="Center" Width="800" Margin="0,0,0,11">
        <TextBox HorizontalAlignment="Left" Margin="400,34,0,0" TextWrapping="Wrap" Text="Добро пожаловать!" VerticalAlignment="Top" Width="288" TextChanged="TextBox_TextChanged" Height="59" FontSize="30" UndoLimit="101"/>
        <TextBox HorizontalAlignment="Left" Margin="400,138,0,0" TextWrapping="Wrap" Text="Почта" VerticalAlignment="Top" Width="120" FontSize="25"/>
        <TextBox HorizontalAlignment="Left" Margin="400,245,0,0" TextWrapping="Wrap" Text="Пароль" VerticalAlignment="Top" Width="120" FontSize="25"/>
        <TextBox HorizontalAlignment="Left" Margin="460,364,0,0" TextWrapping="Wrap" Text="Восстановить пароль" VerticalAlignment="Top" Width="272" FontSize="25" TextChanged="TextBox_TextChanged_1"/>
        <Button Content="Войти" HorizontalAlignment="Left" Margin="400,434,0,0" VerticalAlignment="Top" FontSize="20" Background="#FFF96060" Height="53" Width="288" Foreground="White" OpacityMask="Black" Click="Button_Click" BorderThickness="0,1,1,1">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10 10 0 0"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button Content="Регистрация" HorizontalAlignment="Left" Margin="400,509,0,0" VerticalAlignment="Top" FontSize="20" Background="#FFF96060" Height="53" Width="288" Foreground="White" OpacityMask="Black">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="0 0 10 10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Image Margin="72,50,526,348" Source="/Image1.png" Stretch="Fill" Height="202"/>
        <TextBox TextWrapping="Wrap" Text="TextBox" Margin="400,185,112,383" TextChanged="TextBox_TextChanged_2" FontSize="16"/>
        <TextBox TextWrapping="Wrap" Text="TextBox" Margin="400,300,112,268" TextChanged="TextBox_TextChanged_2" FontSize="16"/>

    </Grid>
</Window>
