<Window x:Class="Desktop.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        Title="Registration" Height="600" Width="800">
    <Grid Height="600" HorizontalAlignment="Right" Margin="0,0,0,-16" Width="800">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="509*"/>
            <ColumnDefinition Width="291*"/>
        </Grid.ColumnDefinitions>
        <TextBox HorizontalAlignment="Left" Margin="400,50,0,0" TextWrapping="Wrap" Text="Welcome back" VerticalAlignment="Top" Width="288" TextChanged="TextBox_TextChanged" Height="59" FontSize="30" UndoLimit="101" Grid.ColumnSpan="2" OpacityMask="Black"/>
        <TextBox HorizontalAlignment="Left" Margin="400,116,0,0" TextWrapping="Wrap" Text="Имя пользователя" VerticalAlignment="Top" Width="288" FontSize="25" Grid.ColumnSpan="2" OpacityMask="Black"/>
        <TextBox HorizontalAlignment="Left" Margin="400,203,0,0" TextWrapping="Wrap" Text="Ваша почта" VerticalAlignment="Top" Width="173" FontSize="25" Grid.ColumnSpan="2" OpacityMask="Black"/>
        <TextBox HorizontalAlignment="Left" Margin="400,0,0,0" TextWrapping="Wrap" Text="Пароль" VerticalAlignment="Center" Width="272" FontSize="25" Grid.ColumnSpan="2" OpacityMask="Black"/>
        <Button Content="Зарегестрироваться" HorizontalAlignment="Left" Margin="400,453,0,0" VerticalAlignment="Top" FontSize="20" Background="#FFF96060" Height="53" Width="288" Foreground="White" Grid.ColumnSpan="2" OpacityMask="Black" Click="Button_Click" Grid.RowSpan="4" BorderThickness="0,1,1,1">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10 10 0 0"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button Content="Назад" HorizontalAlignment="Left" Margin="400,517,0,0" VerticalAlignment="Top" FontSize="20" Background="#FFF96060" Height="53" Width="288" Foreground="White" Grid.ColumnSpan="2" OpacityMask="Black">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="0 0 10 10"/>
                </Style>
            </Button.Resources>
        </Button>
        <Image Margin="72,50,235,348" Source="/Image1.png" Stretch="Fill" Height="202" OpacityMask="Black"/>
        <TextBox Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="400,368,0,0" TextWrapping="Wrap" Text="Повторите пароль" VerticalAlignment="Top" Width="254" FontSize="24"/>
        <TextBox TextWrapping="Wrap" Text="TextBox" Margin="400,156,112,412" TextChanged="TextBox_TextChanged_2" Grid.ColumnSpan="2" FontSize="16"/>
        <TextBox TextWrapping="Wrap" Text="TextBox" Margin="400,243,112,325" TextChanged="TextBox_TextChanged_2" Grid.ColumnSpan="2" FontSize="16"/>
        <TextBox TextWrapping="Wrap" Text="TextBox" Margin="400,323,112,245" TextChanged="TextBox_TextChanged_2" Grid.ColumnSpan="2" FontSize="16"/>
        <TextBox TextWrapping="Wrap" Text="TextBox" Margin="400,407,112,161" TextChanged="TextBox_TextChanged_2" Grid.ColumnSpan="2" FontSize="16"/>

    </Grid>
</Window>
